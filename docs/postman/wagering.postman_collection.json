          "name": "List processes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{app}}/processes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{app}}",
                "processes"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "disabled": true,
                  "description": "admin only: act for this user instead of yourself"
                }
              ]
            },
            "description": "Every process the user has a settings document for, sorted, with its runtime status: active | stopped | not-added | offline (runtime or app down)."
          }
