# Copy to .env and fill in. Every variable is required: a missing one is fatal
# at startup. Values below are placeholders.

ADMIN_USER_ID=00000000-0000-0000-0000-000000000001

# file:///path for dev, s3://bucket/prefix for real. s3:// takes AWS
# credentials and region from the SDK default chain.
SETTINGS_URL=file:///tmp/wagering/settings

# ADMIN's dev proxy targets this port for /wagering-api.
WAGERING_PORT=8080

# SESSION's JWKS endpoint and the iss its tokens carry (SESSION's "issuer"
# setting, default bazbet-session).
JWK_URL=http://localhost:8000/.well-known/jwks.json
JWT_ISSUER=bazbet-session

# Minimum level per output: debug | info | bet | warn | error
# stderr
LOG_LEVEL=debug
# the in-memory ring behind GET /api/logs and ADMIN's Logs page
LOG_RING_LEVEL=info
# Telegram log channel. Bets always go to the bet channel whatever this is.
LOG_TG_LEVEL=warn
LOG_RING_SIZE=10000

LOG_TG_BOT_TOKEN=123456789:AAAA-mock-telegram-bot-token
LOG_TG_CHANNEL_ID=-1001234567890
LOG_TG_BET_CHANNEL_ID=-1001234567891
LOG_TG_QUEUE_SIZE=1000
# 0 disables dedupe
LOG_TG_DEDUPE_MS=60000
